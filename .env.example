# Copy to .env and fill in. Nothing here is real.
# Account ids and ARNs are deliberately NOT committed — see LOCAL.md (gitignored).

AWS_PROFILE=arch
AWS_REGION=us-east-1

# Set after `just deploy`; read by the eval harness.
AGENTCORE_RUNTIME_ARN=
AGENTCORE_GATEWAY_URL=
AGENTCORE_MEMORY_ID=

# Set after `just deploy`; used by the evaluation harness.
AGENTCORE_EVALUATOR_ARN=
AGENTCORE_RUBRIC_EVALUATOR_ARN=
JUDGE_MODEL_ID=deepseek.v3.2

# Phase 2: identity. Set from `just deploy` outputs + `just identity-setup`.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
AGENTCORE_GATEWAY_ID=
POLICY_ENGINE_ARN=
IDENTITY_TEST_USER=support-user
IDENTITY_TEST_PASSWORD=

# Local Phoenix export (shared observability stack on this machine).
PHOENIX_OTLP_ENDPOINT=
PHOENIX_PROJECT_NAME=agentcore-gateway

# Phase 6: hosting comparison and prompt A/B (from `just deploy` outputs).
AGENTCORE_HARNESS_ARN=
AGENTCORE_FRONT_GATEWAY_ARN=
AGENTCORE_FRONT_GATEWAY_URL=
AGENTCORE_ONLINE_EVAL_ARN=
AGENTCORE_AB_TEST_ROLE_ARN=
